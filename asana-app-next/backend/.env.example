# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asana_next?schema=public"

JWT_SECRET=""
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3000"

# Resend: echten API-Key von https://resend.com/api-keys eintragen.
# Ohne gueltigen Key schlaegt nur der Mailversand fehl (try/catch in
# routes/auth.js faengt das ab), die Registrierung selbst funktioniert trotzdem.re_platzhalter_ersetzen
RESEND_API_KEY=""
# onboarding@resend.dev ist Resends Sandbox-Absender, funktioniert ohne eigene
# verifizierte Domain, aber nur zum Testen (Versand nur an den eigenen Account).
RESEND_FROM_EMAIL="onboarding@resend.dev"

#keys für web-push
PUSH_PUBLIC_KEY=""
PUSH_PRIVATE_KEY=""